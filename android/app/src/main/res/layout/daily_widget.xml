<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_quote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="4"
        android:fontFamily="serif" android:textSize="16sp" android:textColor="#372A24"
        android:text="@string/app_name" />
    <TextView android:id="@+id/widget_author" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="6dp"
        android:ellipsize="end" android:maxLines="1" android:textSize="12sp"
        android:textColor="#65483B" />
</LinearLayout>
